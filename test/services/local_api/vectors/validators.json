  "payloads": {
    "rule": "standard base64 with padding (RFC 4648 section 4) of 1 to limits.maxPayloadBytes bytes; these cases assume maxPayloadBytes = 163. 'either' means ok or bad_request are both conformant.",
    "maxPayloadBytes": 163,
    "cases": [
      {
        "why": "smallest payload",
        "bytes": 1,
        "payload": "AA==",
        "expect": "ok"
      },
      {
        "why": "the recommended maxPayloadBytes",
        "bytes": 163,
        "payload": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0+P0BBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5fYGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6e3x9fn+AgYKDhIWGh4iJiouMjY6PkJGSk5SVlpeYmZqbnJ2en6Chog==",
        "expect": "ok"
      },
      {
        "why": "one byte over 163",
        "bytes": 164,
        "payload": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0+P0BBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5fYGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6e3x9fn+AgYKDhIWGh4iJiouMjY6PkJGSk5SVlpeYmZqbnJ2en6ChoqM=",
        "expect": "payload_too_large"
      },
      {
        "why": "MeshCore's radio-side limit, still over the API's 163",
        "bytes": 165,
        "payload": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0+P0BBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5fYGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6e3x9fn+AgYKDhIWGh4iJiouMjY6PkJGSk5SVlpeYmZqbnJ2en6ChoqOk",
        "expect": "payload_too_large"
      },
      {
        "why": "empty string",
        "payload": "",
        "expect": "bad_request"
      },
      {
        "why": "not base64",
        "payload": "***",
        "expect": "bad_request"
      },
      {
        "why": "base64url alphabet; clients MUST NOT send it, servers MAY accept it",
        "payload": "-_-_",
        "expect": "either"
      },
      {
        "why": "unpadded standard base64 of 1 byte; clients MUST NOT send it, servers MAY accept it",
        "payload": "AA",
        "expect": "either"
      },
      {
        "why": "payload is a number",
        "payload": 12,
        "expect": "bad_request"
      }
    ]
  },
  "dataTypes": {
    "rule": "integer 1 to 65535",
    "cases": [
      {
        "dataType": 1,
        "expect": "ok"
      },
      {
        "dataType": 336,
        "expect": "ok"
      },
      {
        "dataType": 65535,
        "expect": "ok"
      },
      {
        "dataType": 0,
        "expect": "invalid_data_type"
      },
      {
        "dataType": -1,
        "expect": "invalid_data_type"
      },
      {
        "dataType": 65536,
        "expect": "invalid_data_type"
      },
      {
        "dataType": "336",
        "expect": "bad_request"
      },
      {
        "dataType": 336.5,
        "expect": "bad_request"
      },
      {
        "dataType": null,
        "expect": "bad_request"
      }
    ]
  },
  "texts": {
    "rule": "string of 1 to 2000 Unicode code points",
    "cases": [
      {
        "why": "one character",
        "text": "a",
        "expect": "ok"
      },
      {
        "why": "2000 code points",
        "textRepeat": {
          "unit": "a",
          "count": 2000
        },
        "expect": "ok"
      },
      {
        "why": "2001 code points",
        "textRepeat": {
          "unit": "a",
          "count": 2001
        },
        "expect": "bad_request"
      },
      {
        "why": "2000 code points outside the BMP (4000 UTF-16 code units, 8000 UTF-8 bytes)",
        "textRepeat": {
          "unit": "😀",
          "count": 2000
        },
        "expect": "ok"
      },
      {
        "why": "empty",
        "text": "",
        "expect": "bad_request"
      },
      {
        "why": "not a string",
        "text": 5,
        "expect": "bad_request"
      }
    ]
  },
  "clientIdentity": {
    "rule": "hello.client.name: 1 to 64 code points after trimming, no control characters; version: 0 to 32 code points, no control characters",
    "cases": [
      {
        "name": "Roadbeacon",
        "version": "0.4.0",
        "expect": "ok"
      },
      {
        "name": "  Roadbeacon  ",
        "version": "",
        "expect": "ok",
        "storedName": "Roadbeacon"
      },
      {
        "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "version": "vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv",
        "expect": "ok"
      },
      {
        "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "version": "1",
        "expect": "bad_request"
      },
      {
        "name": "a",
        "version": "vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv",
        "expect": "bad_request"
