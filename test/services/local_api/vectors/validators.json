  "paths": {
    "rule": "hex, even length, upper or lower case; pathHashSize 1, 2 or 3 (default 1); length a multiple of pathHashSize; at most 63 hops and 64 bytes. Absent or null path: flood. Empty path: zero-hop. pathLenByte is the firmware's packed path_len: (pathHashSize - 1) << 6 | hops.",
    "cases": [
      {
        "path": null,
        "result": "flood"
      },
      {
        "path": "",
        "result": "zero_hop",
        "hops": 0,
        "pathLenByte": 0
      },
      {
        "path": "",
        "pathHashSize": 1,
        "result": "zero_hop",
        "hops": 0,
        "pathLenByte": 0
      },
      {
        "path": "",
        "pathHashSize": 2,
        "result": "zero_hop",
        "hops": 0,
        "pathLenByte": 64
      },
      {
        "path": "",
        "pathHashSize": 3,
        "result": "zero_hop",
        "hops": 0,
        "pathLenByte": 128
      },
      {
        "path": "a1",
        "result": "direct",
        "hops": 1,
        "pathLenByte": 1
      },
      {
        "path": "a1b2c3",
        "pathHashSize": 1,
        "result": "direct",
        "hops": 3,
        "pathLenByte": 3
      },
      {
