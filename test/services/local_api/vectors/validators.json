        "hops": 3,
        "pathLenByte": 3
      },
      {
        "path": "a1b2c3",
        "pathHashSize": 2,
        "error": "bad_request",
        "reason": "length is not a multiple of pathHashSize"
      },
      {
        "path": "a1b2c3",
        "pathHashSize": 3,
        "result": "direct",
        "hops": 1,
        "pathLenByte": 129
      },
      {
